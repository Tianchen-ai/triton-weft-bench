{
  "defaults": {"output_root": "/work/triton-weft-bench/output/current"},
  "targets": {
    "x86-1t": {
      "catalog": "x86-1t",
      "threads": 1,
      "deployment": {"workspace": "/work/triton-weft-bench/output/workers", "cpus": [0]},
      "target": {"architecture": "x86_64", "march": "sapphirerapids"},
      "toolchain": {"cc": ["clang"], "cxx": ["clang++"]},
      "baselines": {"operators": "/work/triton-weft-bench/output/baselines/x86-1t"},
      "default_implementations": {"op": ["weft"]},
      "triton_runtime": {"include": "/path/to/triton/_C/weft/include", "library": "/path/to/triton/_C/weft/lib/libweft_runtime.so"},
      "implementations": {
        "weft": {"factory": "weft_bench.adapters.triton_native:TritonAdapter", "python": "/path/to/environment/bin/python"}
      }
    }
  }
}
